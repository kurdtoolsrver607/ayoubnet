{
  "entities": {
    "TradingUser": {
      "title": "TradingUser",
      "description": "Isolated trading application user profile stored at users/{uid}.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "isBlocked": { "type": "boolean" },
        "balance": { "type": "number" },
        "accountType": { "type": "string", "enum": ["standard", "cent"] },
        "language": { "type": "string", "enum": ["en", "ar", "ku"] },
        "theme": { "type": "string", "enum": ["dark", "light"] },
        "dailyMaxLossPct": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "displayName", "role", "isBlocked"]
    },
    "TradeSignal": {
      "title": "TradeSignal",
      "description": "Private trading journal entry scoped strictly to users/{uid}/trades/{tradeId}.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "pair": { "type": "string" },
        "type": { "type": "string", "enum": ["BUY", "SELL", "BUY LIMIT", "SELL LIMIT", "BUY STOP", "SELL STOP"] },
        "entryPrice": { "type": "number" },
        "stopLoss": { "type": "number" },
        "tp1": { "type": "number" },
        "tp2": { "type": "number" },
        "tp3": { "type": "number" },
        "tp1Hit": { "type": "boolean" },
        "tp2Hit": { "type": "boolean" },
        "tp3Hit": { "type": "boolean" },
        "hitReason": { "type": "string" },
        "triggeredPrice": { "type": "number" },
        "closedPrice": { "type": "number" },
        "lotSize": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Active", "Won", "Lost"] },
        "pips": { "type": "number" },
        "riskReward": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "pair", "type", "entryPrice", "stopLoss", "tp1", "lotSize", "status"]
    },
    "PriceAlert": {
      "title": "PriceAlert",
      "description": "Private per-user custom price alert / alarm stored at users/{uid}/alerts/{alertId}.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "pair": { "type": "string" },
        "targetPrice": { "type": "number" },
        "condition": { "type": "string", "enum": ["above", "below"] },
        "active": { "type": "boolean" },
        "triggered": { "type": "boolean" },
        "triggeredPrice": { "type": "number" },
        "triggeredAt": { "type": "string", "format": "date-time" },
        "note": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "pair", "targetPrice", "condition", "active"]
    },
    "PublicFeedPost": {
      "title": "PublicFeedPost",
      "description": "Admin-authored broadcast post (announcement, image, video, or public signal).",
      "type": "object",
      "properties": {
        "authorUid": { "type": "string" },
        "authorEmail": { "type": "string", "format": "email" },
        "authorName": { "type": "string" },
        "postType": { "type": "string", "enum": ["announcement", "signal", "media"] },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "imageUrl": { "type": "string" },
        "videoUrl": { "type": "string" },
        "signal": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorUid", "authorEmail", "postType", "title"]
    },
    "Channel": {
      "title": "Channel",
      "description": "Telegram-style public trading channel created by any logged-in user.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "ownerName": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "subscribers": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "ownerName", "name", "subscribers"]
    },
    "ChannelPost": {
      "title": "ChannelPost",
      "description": "Broadcast post inside a channel supporting signals, text, images, videos, unique views, reactions, and optional comments.",
      "type": "object",
      "properties": {
        "channelId": { "type": "string" },
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" },
        "postType": { "type": "string", "enum": ["text", "signal", "media"] },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "imageUrl": { "type": "string" },
        "videoUrl": { "type": "string" },
        "signal": { "type": "object" },
        "commentsEnabled": { "type": "boolean" },
        "viewedBy": { "type": "array", "items": { "type": "string" } },
        "reactions": { "type": "object" },
        "commentCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["channelId", "authorUid", "authorName", "postType", "commentsEnabled"]
    },
    "ChannelComment": {
      "title": "ChannelComment",
      "description": "User comment on a channel post when commentsEnabled is true.",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "authorUid", "authorName", "text"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "Admin-managed global app configuration (maintenance switch and live global popup dialog).",
      "type": "object",
      "properties": {
        "maintenanceEnabled": { "type": "boolean" },
        "maintenanceMessage": { "type": "string" },
        "popup": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "GlobalNotification": {
      "title": "GlobalNotification",
      "description": "Admin-broadcast notification pushed to all users' Notification Center.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "imageUrl": { "type": "string" },
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "body", "authorUid"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/TradingUser" },
      "description": "User profiles for /trading with role and server-enforced isBlocked flag."
    },
    "/users/{userId}/trades/{tradeId}": {
      "schema": { "$ref": "#/entities/TradeSignal" },
      "description": "Strictly private per-user trading signals and journal entries."
    },
    "/users/{userId}/alerts/{alertId}": {
      "schema": { "$ref": "#/entities/PriceAlert" },
      "description": "Strictly private per-user custom price alerts / alarms."
    },
    "/public_posts/{postId}": {
      "schema": { "$ref": "#/entities/PublicFeedPost" },
      "description": "Public feed posts readable by active logged-in users and writable only by Admin (tafteshok@gmail.com)."
    },
    "/channels/{channelId}": {
      "schema": { "$ref": "#/entities/Channel" },
      "description": "Telegram-style public channels created by logged-in traders."
    },
    "/channel_posts/{postId}": {
      "schema": { "$ref": "#/entities/ChannelPost" },
      "description": "Channel posts with unique views, emoji reactions, and toggleable comments."
    },
    "/channel_posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/ChannelComment" },
      "description": "Comments under a channel post."
    },
    "/app_config/{docId}": {
      "schema": { "$ref": "#/entities/AppConfig" },
      "description": "Admin maintenance switch and global popup dialog configuration."
    },
    "/global_notifications/{notifId}": {
      "schema": { "$ref": "#/entities/GlobalNotification" },
      "description": "Global admin notification broadcasts."
    }
  }
}
